+            </div>
+          </dl>
+
+          <div
+            class="curve-chart"
+            role="img"
+            :aria-label="$t('pageFanControl.curveTitle')"
+          >
+            <svg viewBox="0 0 680 360" aria-hidden="true">
+              <g class="chart-grid">
+                <line
+                  v-for="tick in outputTicks"
+                  :key="`output-grid-${tick}`"
+                  :x1="chart.left"
+                  :x2="chart.width - chart.right"
+                  :y1="outputY(tick)"
+                  :y2="outputY(tick)"
+                />
+                <line
+                  v-for="tick in temperatureTicks"
+                  :key="`temperature-grid-${tick}`"
+                  :x1="temperatureX(tick)"
+                  :x2="temperatureX(tick)"
+                  :y1="chart.top"
+                  :y2="chart.height - chart.bottom"
+                />
+              </g>
+
+              <g class="chart-labels">
+                <text
+                  v-for="tick in outputTicks"
+                  :key="`output-label-${tick}`"
+                  :x="chart.left - 10"
+                  :y="outputY(tick) + 4"
+                  text-anchor="end"
+                >
+                  {{ tick }}
+                </text>
+                <text
+                  v-for="tick in temperatureTicks"
+                  :key="`temperature-label-${tick}`"
+                  :x="temperatureX(tick)"
+                  :y="chart.height - chart.bottom + 24"
+                  text-anchor="middle"
+                >
+                  {{ tick }}
+                </text>
+                <text
+                  :x="chart.left + plotWidth / 2"
+                  :y="chart.height - 8"
+                  text-anchor="middle"
+                >
+                  {{ $t('pageFanControl.temperatureAxis') }}
+                </text>
+                <text
+                  :x="16"
+                  :y="chart.top + plotHeight / 2"
+                  text-anchor="middle"
+                  :transform="`rotate(-90 16 ${chart.top + plotHeight / 2})`"
+                >
+                  {{ $t('pageFanControl.outputAxis') }}
+                </text>
+              </g>
+
+              <path class="curve-line" :d="stepPath" />
+
+              <g v-if="currentTemperatureInRange">
+                <line
+                  class="current-temperature-line"
+                  :x1="temperatureX(tr1Temperature)"
+                  :x2="temperatureX(tr1Temperature)"
+                  :y1="chart.top"
+                  :y2="chart.height - chart.bottom"
+                />
+                <circle
+                  class="current-target-point"
+                  :cx="temperatureX(tr1Temperature)"
+                  :cy="outputY(currentTarget)"
+                  r="6"
+                />
+              </g>
+            </svg>
+          </div>
+        </b-card>
+      </b-col>
+
+      <b-col xl="4">
+        <b-card class="mb-4">
+          <b-table-simple responsive>
+            <b-thead>
+              <b-tr>
+                <b-th>{{ $t('pageFanControl.pointColumn') }}</b-th>
+                <b-th>{{ $t('pageFanControl.temperature') }}</b-th>
+                <b-th>{{ $t('pageFanControl.output') }}</b-th>
+              </b-tr>
+            </b-thead>
+            <b-tbody>
+              <b-tr v-for="(point, index) in points" :key="index">
+                <b-th scope="row">{{ index + 1 }}</b-th>
+                <b-td>
+                  <b-form-input
+                    v-model.number="point.temperature"
+                    type="number"
+                    min="-40"
+                    max="150"
+                    step="0.5"
+                    :aria-label="
+                      $t('pageFanControl.temperature') + ' ' + (index + 1)
+                    "
+                    :state="inputState"
+                  />
+                </b-td>
+                <b-td>
+                  <b-form-input
+                    v-model.number="point.output"
+                    type="number"
+                    min="30"
+                    max="100"
+                    step="1"
+                    :aria-label="
+                      $t('pageFanControl.output') + ' ' + (index + 1)
+                    "
+                    :state="inputState"
+                  />
+                </b-td>
+              </b-tr>
+            </b-tbody>
+          </b-table-simple>
+
+          <b-alert :show="points.length > 0 && !curveIsValid" variant="danger">
+            {{ $t('pageFanControl.validation') }}
+          </b-alert>
+
+          <dl class="hysteresis">
+            <div>
+              <dt>{{ $t('pageFanControl.positiveHysteresis') }}</dt>
+              <dd>{{ positiveHysteresis }} °C</dd>
+            </div>
+            <div>
+              <dt>{{ $t('pageFanControl.negativeHysteresis') }}</dt>
+              <dd>{{ negativeHysteresis }} °C</dd>
+            </div>
+          </dl>
+
+          <b-button
+            variant="primary"
+            class="me-2"
+            :disabled="!curveIsValid || saving"
+            @click="saveCurve"
+          >
+            {{ $t('global.action.saveSettings') }}
+          </b-button>
+          <b-button variant="secondary" :disabled="saving" @click="loadCurve">
+            {{ $t('global.action.reset') }}
+          </b-button>
+        </b-card>
+      </b-col>
+    </b-row>
+  </b-container>
+</template>
+
+<script>
+import PageTitle from '@/components/Global/PageTitle';
+import LoadingBarMixin from '@/components/Mixins/LoadingBarMixin';
+import BVToastMixin from '@/components/Mixins/BVToastMixin';
+
+const pointCount = 7;
+
+export default {
+  name: 'FanControl',
+  components: { PageTitle },
+  mixins: [BVToastMixin, LoadingBarMixin],
+  beforeRouteLeave(to, from, next) {
+    this.hideLoader();
+    next();
+  },
+  data() {
+    return {
+      chart: {
+        width: 680,
+        height: 360,
+        left: 64,
+        right: 20,
+        top: 20,
+        bottom: 54,
+      },
+      points: [],
+      saving: false,
+    };
+  },
+  computed: {
+    readings() {
+      return this.$store.getters['fanControl/readings'];
+    },
+    outputs() {
+      return this.$store.getters['fanControl/outputs'];
+    },
+    positiveHysteresis() {
+      return this.$store.getters['fanControl/positiveHysteresis'];
+    },
+    negativeHysteresis() {
+      return this.$store.getters['fanControl/negativeHysteresis'];
+    },
+    tr1Temperature() {
+      return this.$store.getters['fanControl/tr1Temperature'];
+    },
+    plotWidth() {
+      return this.chart.width - this.chart.left - this.chart.right;
+    },
+    plotHeight() {
+      return this.chart.height - this.chart.top - this.chart.bottom;
+    },
+    temperatureMinimum() {
+      if (!this.points.length) return 0;
+      return Math.floor((this.points[0].temperature - 5) / 5) * 5;
+    },
+    temperatureMaximum() {
+      if (!this.points.length) return 60;
+      const last = this.points[this.points.length - 1].temperature;
+      return Math.max(
+        Math.ceil((last + 5) / 5) * 5,
+        this.temperatureMinimum + 5,
+      );
+    },
+    temperatureTicks() {
+      const range = this.temperatureMaximum - this.temperatureMinimum;
+      return Array.from(
+        { length: 6 },
+        (_, index) => this.temperatureMinimum + (range * index) / 5,
+      );
+    },
+    outputTicks() {
+      return [0, 20, 40, 60, 80, 100];
+    },
+    stepPath() {
+      if (!this.curveIsValid) return '';
+      const path = [
+        `M ${this.temperatureX(this.temperatureMinimum)} ${this.outputY(
+          this.points[0].output,
+        )}`,
+      ];
+
+      this.points.slice(1).forEach((point) => {
+        path.push(`H ${this.temperatureX(point.temperature)}`);
+        path.push(`V ${this.outputY(point.output)}`);
+      });
+      path.push(`H ${this.temperatureX(this.temperatureMaximum)}`);
+      return path.join(' ');
+    },
+    curveNumbersAreFinite() {
+      return this.points.every(
+        (point) =>
+          Number.isFinite(point.temperature) && Number.isFinite(point.output),
+      );
+    },
+    curveIsValid() {
+      if (this.points.length !== pointCount || !this.curveNumbersAreFinite) {
+        return false;
+      }
+
+      return this.points.every((point, index) => {
+        const previous = this.points[index - 1];
+        return (
+          point.temperature >= -40 &&
+          point.temperature <= 150 &&
+          point.output >= 30 &&
+          point.output <= 100 &&
+          (!previous ||
+            (point.temperature > previous.temperature &&
+              point.output >= previous.output)) &&
+          (index !== this.points.length - 1 || point.output === 100)
+        );
+      });
+    },
+    inputState() {
+      return this.curveIsValid ? null : false;
+    },
+    currentTarget() {
+      if (
+        !Number.isFinite(this.tr1Temperature) ||
+        !this.points.length ||
+        !this.curveNumbersAreFinite
+      ) {
+        return null;
+      }
+
+      let target = this.points[0].output;
+      this.points.slice(1).forEach((point) => {
+        if (this.tr1Temperature >= point.temperature) {
+          target = point.output;
+        }
+      });
+      return target;
+    },
+    currentTemperatureInRange() {
+      return (
+        Number.isFinite(this.tr1Temperature) &&
+        Number.isFinite(this.currentTarget) &&
+        this.tr1Temperature >= this.temperatureMinimum &&
+        this.tr1Temperature <= this.temperatureMaximum
+      );
+    },
+    formattedTemperature() {
+      return Number.isFinite(this.tr1Temperature)
+        ? `${this.tr1Temperature.toFixed(1)} °C`
+        : this.$t('pageFanControl.unavailable');
+    },
+    formattedTarget() {
+      return Number.isFinite(this.currentTarget)
+        ? `${this.currentTarget}%`
+        : this.$t('pageFanControl.unavailable');
+    },
+  },
+  created() {
+    this.loadCurve();
+  },
+  methods: {
+    setPointsFromStore() {
+      this.points = this.readings.map((temperature, index) => ({
+        temperature,
+        output: this.outputs[index],
+      }));
+    },
+    temperatureX(value) {
+      const range = this.temperatureMaximum - this.temperatureMinimum;
+      return (
+        this.chart.left +
+        ((value - this.temperatureMinimum) / range) * this.plotWidth
+      );
+    },
+    outputY(value) {
+      return this.chart.top + ((100 - value) / 100) * this.plotHeight;
+    },
+    async loadCurve() {
+      this.startLoader();
+      try {
+        await this.$store.dispatch('fanControl/getFanCurve');
+        this.setPointsFromStore();
+      } catch ({ message }) {
+        this.errorToast(message);
+      } finally {
+        this.endLoader();
+      }
+    },
+    async saveCurve() {
+      if (!this.curveIsValid) return;
+
+      this.saving = true;
+      this.startLoader();
+      try {
+        const message = await this.$store.dispatch('fanControl/saveFanCurve', {
+          readings: this.points.map((point) => point.temperature),
+          outputs: this.points.map((point) => point.output),
+        });
+        this.successToast(message);
+      } catch ({ message }) {
+        this.errorToast(message);
+        this.setPointsFromStore();
+      } finally {
+        this.saving = false;
+        this.endLoader();
+      }
+    },
+  },
+};
+</script>
+
+<style lang="scss" scoped>
