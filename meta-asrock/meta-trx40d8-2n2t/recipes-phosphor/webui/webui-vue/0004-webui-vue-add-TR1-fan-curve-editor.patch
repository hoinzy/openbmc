@@ -0,0 +1,125 @@
+export const MINIMUM_POINTS = 2;
+export const MAXIMUM_POINTS = 20;
+export const MINIMUM_TEMPERATURE = -40;
+export const MAXIMUM_TEMPERATURE = 150;
+export const MINIMUM_OUTPUT = 30;
+export const MAXIMUM_OUTPUT = 100;
+
+const minimumTemperatureGap = 0.1;
+
+function clamp(value, minimum, maximum) {
+  return Math.min(Math.max(value, minimum), maximum);
+}
+
+function round(value, digits) {
+  const factor = 10 ** digits;
+  return Math.round(value * factor) / factor;
+}
+
+export function curveIsValid(points) {
+  if (points.length < MINIMUM_POINTS || points.length > MAXIMUM_POINTS) {
+    return false;
+  }
+
+  return points.every((point, index) => {
+    const previous = points[index - 1];
+    return (
+      Number.isFinite(point.temperature) &&
+      Number.isFinite(point.output) &&
+      point.temperature >= MINIMUM_TEMPERATURE &&
+      point.temperature <= MAXIMUM_TEMPERATURE &&
+      point.output >= MINIMUM_OUTPUT &&
+      point.output <= MAXIMUM_OUTPUT &&
+      (!previous ||
+        (point.temperature > previous.temperature &&
+          point.output >= previous.output)) &&
+      (index !== points.length - 1 || point.output === MAXIMUM_OUTPUT)
+    );
+  });
+}
+
+export function interpolateCurve(points, temperature) {
+  if (!curveIsValid(points) || !Number.isFinite(temperature)) return null;
+  if (temperature <= points[0].temperature) return points[0].output;
+
+  for (let index = 1; index < points.length; index += 1) {
+    const previous = points[index - 1];
+    const current = points[index];
+    if (temperature <= current.temperature) {
+      const fraction =
+        (temperature - previous.temperature) /
+        (current.temperature - previous.temperature);
+      return previous.output + fraction * (current.output - previous.output);
+    }
+  }
+
+  return points[points.length - 1].output;
+}
+
+export function constrainCurvePoint(points, index, temperature, output) {
+  const previous = points[index - 1];
+  const next = points[index + 1];
+  const minimumTemperature = previous
+    ? previous.temperature + minimumTemperatureGap
+    : MINIMUM_TEMPERATURE;
+  const maximumTemperature = next
+    ? next.temperature - minimumTemperatureGap
+    : MAXIMUM_TEMPERATURE;
+  const minimumOutput = previous ? previous.output : MINIMUM_OUTPUT;
+  const maximumOutput = next ? next.output : MAXIMUM_OUTPUT;
+
+  return {
+    temperature: round(
+      clamp(temperature, minimumTemperature, maximumTemperature),
+      1,
+    ),
+    output:
+      index === points.length - 1
+        ? MAXIMUM_OUTPUT
+        : round(clamp(output, minimumOutput, maximumOutput), 1),
+  };
+}
+
+export function insertCurvePoint(points, temperature, output) {
+  if (points.length >= MAXIMUM_POINTS) return points;
+
+  const insertionIndex = points.findIndex(
+    (point) => point.temperature > temperature,
+  );
+  const index = insertionIndex === -1 ? points.length : insertionIndex;
+  const nextPoints = points.map((point) => ({ ...point }));
+  nextPoints.splice(index, 0, { temperature, output });
+  nextPoints[index] = constrainCurvePoint(
+    nextPoints,
+    index,
+    temperature,
+    output,
+  );
+
+  if (!curveIsValid(nextPoints)) return points;
+  return nextPoints;
+}
+
+export function insertPointInWidestGap(points) {
+  if (!curveIsValid(points) || points.length >= MAXIMUM_POINTS) return points;
+
+  let leftIndex = 0;
+  let widestGap = points[1].temperature - points[0].temperature;
+  for (let index = 1; index < points.length - 1; index += 1) {
+    const gap = points[index + 1].temperature - points[index].temperature;
+    if (gap > widestGap) {
+      widestGap = gap;
+      leftIndex = index;
+    }
+  }
+
+  const temperature = round(
+    (points[leftIndex].temperature + points[leftIndex + 1].temperature) / 2,
+    1,
+  );
+  return insertCurvePoint(
+    points,
+    temperature,
+    interpolateCurve(points, temperature),
+  );
+}
