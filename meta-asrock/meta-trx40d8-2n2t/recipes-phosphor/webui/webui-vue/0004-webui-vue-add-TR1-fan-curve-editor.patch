diff --git a/src/store/modules/HardwareStatus/FanControlStore.js b/src/store/modules/HardwareStatus/FanControlStore.js
new file mode 100644
index 0000000..088d2ca
--- /dev/null
+++ b/src/store/modules/HardwareStatus/FanControlStore.js
@@ -0,0 +1,113 @@
+import api from '@/store/api';
+import i18n from '@/i18n';
+
+const managerPath = '/redfish/v1/Managers/bmc';
+const curveName = 'TR1_Fan_Curve';
+const tr1SensorPath =
+  '/redfish/v1/Chassis/ASRock_Rack_TRX40D8_2N2T/Sensors/temperature_TR1_TEMP';
+
+const FanControlStore = {
+  namespaced: true,
+  state: {
+    readings: [],
+    outputs: [],
+    positiveHysteresis: null,
+    negativeHysteresis: null,
+    tr1Temperature: null,
+  },
+  getters: {
+    readings: (state) => state.readings,
+    outputs: (state) => state.outputs,
+    positiveHysteresis: (state) => state.positiveHysteresis,
+    negativeHysteresis: (state) => state.negativeHysteresis,
+    tr1Temperature: (state) => state.tr1Temperature,
+  },
+  mutations: {
+    setCurve(state, curve) {
+      state.readings = curve.Reading;
+      state.outputs = curve.Output;
+      state.positiveHysteresis = curve.PositiveHysteresis;
+      state.negativeHysteresis = curve.NegativeHysteresis;
+    },
+    setTr1Temperature(state, temperature) {
+      state.tr1Temperature = temperature;
+    },
+  },
+  actions: {
+    async getFanCurve({ commit }) {
+      try {
+        const [curveResponse, sensorResponse] = await api.all([
+          api.get(managerPath),
+          api.get(tr1SensorPath),
+        ]);
+        const curve =
+          curveResponse.data?.Oem?.OpenBmc?.Fan?.StepwiseControllers?.[
+            curveName
+          ];
+        const steps = curve?.Steps;
+        const temperature = sensorResponse.data?.Reading;
+
+        if (
+          !Array.isArray(steps) ||
+          !steps.length ||
+          !steps.every(
+            (step) =>
+              Number.isFinite(step.Target) && Number.isFinite(step.Output),
+          )
+        ) {
+          throw new Error('Invalid fan curve response');
+        }
+
+        commit('setCurve', {
+          Reading: steps.map((step) => step.Target),
+          Output: steps.map((step) => step.Output),
+          PositiveHysteresis: curve.PositiveHysteresis,
+          NegativeHysteresis: curve.NegativeHysteresis,
+        });
+        commit(
+          'setTr1Temperature',
+          Number.isFinite(temperature) ? temperature : null,
+        );
+      } catch (error) {
+        console.log(error);
+        throw new Error(
+          i18n.global.t('pageFanControl.toast.errorLoadSettings'),
+        );
+      }
+    },
+    async saveFanCurve({ commit, dispatch, getters }, { readings, outputs }) {
+      try {
+        const steps = readings.map((target, index) => ({
+          Target: target,
+          Output: outputs[index],
+        }));
+        await api.patch(managerPath, {
+          Oem: {
+            OpenBmc: {
+              Fan: {
+                StepwiseControllers: {
+                  [curveName]: { Steps: steps },
+                },
+              },
+            },
+          },
+        });
+        commit('setCurve', {
+          Reading: readings,
+          Output: outputs,
+          PositiveHysteresis: getters.positiveHysteresis,
+          NegativeHysteresis: getters.negativeHysteresis,
+        });
+        return i18n.global.t('pageFanControl.toast.successSaveSettings');
+      } catch (error) {
+        console.log(error);
+        await dispatch('getFanCurve').catch(() => {});
+        throw new Error(
+          i18n.global.t('pageFanControl.toast.errorSaveSettings'),
+        );
+      }
+    },
+  },
+};
+
+export default FanControlStore;
