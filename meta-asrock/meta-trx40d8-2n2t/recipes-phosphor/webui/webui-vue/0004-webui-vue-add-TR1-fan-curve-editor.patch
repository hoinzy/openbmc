+import { describe, expect, it } from 'vitest';
+
+import {
+  constrainCurvePoint,
+  curveIsValid,
+  insertCurvePoint,
+  insertPointInWidestGap,
+  interpolateCurve,
+} from '@/views/HardwareStatus/FanControl/fanCurve';
+
+const points = [
+  { temperature: 20, output: 40 },
+  { temperature: 30, output: 60 },
+  { temperature: 50, output: 100 },
+];
+
+describe('fan curve helpers', () => {
+  it('interpolates smoothly and clamps outside the configured range', () => {
+    expect(interpolateCurve(points, 10)).toBe(40);
+    expect(interpolateCurve(points, 25)).toBe(50);
+    expect(interpolateCurve(points, 40)).toBe(80);
+    expect(interpolateCurve(points, 60)).toBe(100);
+  });
+
+  it('validates variable-length monotonic curves with a 100% endpoint', () => {
+    expect(curveIsValid(points)).toBe(true);
+    expect(curveIsValid(points.slice(0, 1))).toBe(false);
+    expect(
+      curveIsValid([
+        points[0],
+        { temperature: 30, output: 90 },
+        { temperature: 50, output: 80 },
+      ]),
+    ).toBe(false);
+    expect(
+      curveIsValid([points[0], points[1], { temperature: 50, output: 90 }]),
+    ).toBe(false);
+  });
+
+  it('constrains dragged points between their neighbors', () => {
+    expect(constrainCurvePoint(points, 1, 55, 20)).toEqual({
+      temperature: 49.9,
+      output: 40,
+    });
+    expect(constrainCurvePoint(points, 2, 45, 20)).toEqual({
+      temperature: 45,
+      output: 100,
+    });
+  });
+
+  it('adds control points without restoring a fixed grid', () => {
+    const inserted = insertPointInWidestGap(points);
+    expect(inserted).toHaveLength(4);
+    expect(inserted[2]).toEqual({ temperature: 40, output: 80 });
+
+    const chartInserted = insertCurvePoint(points, 25, 55);
+    expect(chartInserted).toHaveLength(4);
+    expect(chartInserted[1]).toEqual({ temperature: 25, output: 55 });
+  });
+});
