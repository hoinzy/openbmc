+import { createStore } from 'vuex';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+vi.mock('@/store/api', () => ({
+  default: {
+    get: vi.fn(),
+    patch: vi.fn(),
+    all: vi.fn((promises) => Promise.all(promises)),
+  },
+}));
+
+import api from '@/store/api';
+import FanControlStore from '@/store/modules/HardwareStatus/FanControlStore';
+
+const managerPath = '/redfish/v1/Managers/bmc';
+const curveName = 'TR1_Fan_Curve';
+const tr1SensorPath =
+  '/redfish/v1/Chassis/ASRock_Rack_TRX40D8_2N2T/Sensors/temperature_TR1_TEMP';
+const readings = [20, 25, 30, 35, 40, 45, 50];
+const outputs = [50, 55, 60, 70, 80, 90, 100];
+
+function buildStore() {
+  return createStore({
+    modules: {
+      fanControl: FanControlStore,
+    },
+  });
+}
+
+describe('FanControlStore', () => {
+  let store;
+
+  beforeEach(() => {
+    vi.clearAllMocks();
+    store = buildStore();
+    api.get.mockImplementation((path) => {
+      if (path === managerPath) {
+        return Promise.resolve({
+          data: {
+            Oem: {
+              OpenBmc: {
+                Fan: {
+                  StepwiseControllers: {
+                    [curveName]: {
+                      Steps: readings.map((Target, index) => ({
+                        Target,
+                        Output: outputs[index],
+                      })),
+                      PositiveHysteresis: 0.5,
+                      NegativeHysteresis: 0.5,
+                    },
+                  },
+                },
+              },
+            },
+          },
+        });
+      }
+      if (path === tr1SensorPath) {
+        return Promise.resolve({ data: { Reading: 32 } });
+      }
+      return Promise.reject(new Error('Unexpected path'));
+    });
+    api.patch.mockResolvedValue({ data: { status: 'ok' } });
+  });
+
+  it('loads the editable curve and current TR1 temperature', async () => {
+    await store.dispatch('fanControl/getFanCurve');
+
+    expect(store.getters['fanControl/readings']).toEqual(readings);
+    expect(store.getters['fanControl/outputs']).toEqual(outputs);
+    expect(store.getters['fanControl/tr1Temperature']).toBe(32);
+    expect(api.get).toHaveBeenCalledWith(managerPath);
+    expect(api.get).toHaveBeenCalledWith(tr1SensorPath);
+  });
+
+  it('persists the complete curve through the Redfish manager API', async () => {
+    await store.dispatch('fanControl/getFanCurve');
+    await store.dispatch('fanControl/saveFanCurve', {
+      readings,
+      outputs,
+    });
+
+    expect(api.patch).toHaveBeenCalledWith(managerPath, {
+      Oem: {
+        OpenBmc: {
+          Fan: {
+            StepwiseControllers: {
+              [curveName]: {
+                Steps: readings.map((Target, index) => ({
+                  Target,
+                  Output: outputs[index],
+                })),
+              },
+            },
+          },
+        },
+      },
+    });
+  });
+
+  it('rejects malformed curve responses', async () => {
+    api.get.mockImplementation((path) =>
+      Promise.resolve({
+        data: {
+          ...(path === managerPath
+            ? { Oem: { OpenBmc: { Fan: { StepwiseControllers: {} } } } }
+            : { Reading: 32 }),
+        },
+      }),
+    );
+
+    await expect(store.dispatch('fanControl/getFanCurve')).rejects.toThrow(
+      'The fan curve could not be loaded.',
+    );
+  });
+});
