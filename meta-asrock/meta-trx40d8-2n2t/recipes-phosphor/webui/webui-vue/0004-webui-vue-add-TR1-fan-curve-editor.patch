+          <b-form-group
+            :label="$t('pageFanControl.positiveHysteresis')"
+            label-for="positive-hysteresis"
+          >
+            <b-input-group append="°C">
+              <b-form-input
+                id="positive-hysteresis"
+                v-model.number="positiveHysteresis"
+                type="number"
+                min="0"
+                max="20"
+                step="0.1"
+                :state="hysteresisInputState"
+              />
+            </b-input-group>
+          </b-form-group>
+
+          <b-form-group
+            class="mt-3"
+            :label="$t('pageFanControl.negativeHysteresis')"
+            label-for="negative-hysteresis"
+          >
+            <b-input-group append="°C">
+              <b-form-input
+                id="negative-hysteresis"
+                v-model.number="negativeHysteresis"
+                type="number"
+                min="0"
+                max="20"
+                step="0.1"
+                :state="hysteresisInputState"
+              />
+            </b-input-group>
+          </b-form-group>
+
+          <b-alert :show="!hysteresisIsValid" variant="danger" class="mt-3">
+            {{ $t('pageFanControl.hysteresisValidation') }}
+          </b-alert>
+        </b-card>
+
+        <b-button
+          variant="primary"
+          class="me-2"
+          :disabled="!configurationIsValid || saving"
+          @click="saveCurve"
+        >
+          {{ $t('global.action.saveSettings') }}
+        </b-button>
+        <b-button variant="secondary" :disabled="saving" @click="loadCurve">
+          {{ $t('global.action.reset') }}
+        </b-button>
+      </b-col>
+    </b-row>
+  </b-container>
+</template>
+
+<script>
+import PageTitle from '@/components/Global/PageTitle';
+import LoadingBarMixin from '@/components/Mixins/LoadingBarMixin';
+import BVToastMixin from '@/components/Mixins/BVToastMixin';
+import {
+  MAXIMUM_OUTPUT,
+  MAXIMUM_POINTS,
+  MAXIMUM_TEMPERATURE,
+  MINIMUM_OUTPUT,
+  MINIMUM_POINTS,
+  MINIMUM_TEMPERATURE,
+  constrainCurvePoint,
+  curveIsValid,
+  insertCurvePoint,
+  insertPointInWidestGap,
+  interpolateCurve,
+} from './fanCurve';
+
+export default {
+  name: 'FanControl',
+  components: { PageTitle },
+  mixins: [BVToastMixin, LoadingBarMixin],
+  beforeRouteLeave(to, from, next) {
+    this.hideLoader();
+    next();
+  },
+  data() {
+    return {
+      chart: {
+        width: 680,
+        height: 360,
+        left: 64,
+        right: 20,
+        top: 20,
+        bottom: 54,
+      },
+      minimumPoints: MINIMUM_POINTS,
+      maximumPoints: MAXIMUM_POINTS,
+      minimumTemperature: MINIMUM_TEMPERATURE,
+      maximumTemperature: MAXIMUM_TEMPERATURE,
+      minimumOutput: MINIMUM_OUTPUT,
+      maximumOutput: MAXIMUM_OUTPUT,
+      points: [],
+      selectedSources: [],
+      positiveHysteresis: null,
+      negativeHysteresis: null,
+      draggingIndex: null,
+      dragDomain: null,
+      saving: false,
+    };
+  },
+  computed: {
+    readings() {
+      return this.$store.getters['fanControl/readings'];
+    },
+    outputs() {
+      return this.$store.getters['fanControl/outputs'];
+    },
+    inputs() {
+      return this.$store.getters['fanControl/inputs'];
+    },
+    storedPositiveHysteresis() {
+      return this.$store.getters['fanControl/positiveHysteresis'];
+    },
+    storedNegativeHysteresis() {
+      return this.$store.getters['fanControl/negativeHysteresis'];
+    },
+    temperatureSensors() {
+      return this.$store.getters['fanControl/temperatureSensors'];
+    },
+    selectedSensorObjects() {
+      return this.selectedSources.map((input) =>
+        this.temperatureSensors.find((sensor) => sensor.id === input),
+      );
+    },
+    allSelectedSourcesAvailable() {
+      return this.selectedSensorObjects.every(
+        (sensor) => sensor && Number.isFinite(sensor.reading),
+      );
+    },
+    effectiveTemperature() {
+      if (!this.selectedSources.length || !this.allSelectedSourcesAvailable) {
+        return null;
+      }
+      return Math.max(
+        ...this.selectedSensorObjects.map((sensor) => sensor.reading),
+      );
+    },
+    plotWidth() {
+      return this.chart.width - this.chart.left - this.chart.right;
+    },
+    plotHeight() {
+      return this.chart.height - this.chart.top - this.chart.bottom;
+    },
+    temperatureMinimumForChart() {
+      if (this.dragDomain) return this.dragDomain.minimum;
+      if (!this.points.length) return 0;
+      const values = [this.points[0].temperature];
+      if (Number.isFinite(this.effectiveTemperature)) {
+        values.push(this.effectiveTemperature);
+      }
+      return Math.max(
+        MINIMUM_TEMPERATURE,
+        Math.floor((Math.min(...values) - 5) / 5) * 5,
+      );
+    },
+    temperatureMaximumForChart() {
+      if (this.dragDomain) return this.dragDomain.maximum;
+      if (!this.points.length) return 60;
+      const values = [this.points[this.points.length - 1].temperature];
+      if (Number.isFinite(this.effectiveTemperature)) {
+        values.push(this.effectiveTemperature);
+      }
+      return Math.min(
+        MAXIMUM_TEMPERATURE,
+        Math.max(
+          Math.ceil((Math.max(...values) + 5) / 5) * 5,
+          this.temperatureMinimumForChart + 5,
+        ),
+      );
+    },
+    temperatureTicks() {
+      const range =
+        this.temperatureMaximumForChart - this.temperatureMinimumForChart;
+      return Array.from({ length: 6 }, (_, index) =>
+        Number(
+          (this.temperatureMinimumForChart + (range * index) / 5).toFixed(1),
+        ),
+      );
+    },
+    outputTicks() {
+      return [0, 20, 40, 60, 80, 100];
+    },
+    curvePath() {
+      if (!this.curveIsValid) return '';
+      const first = this.points[0];
+      const last = this.points[this.points.length - 1];
+      const path = [
+        `M ${this.temperatureX(this.temperatureMinimumForChart)} ${this.outputY(
+          first.output,
+        )}`,
+        `L ${this.temperatureX(first.temperature)} ${this.outputY(first.output)}`,
+      ];
+      this.points.slice(1).forEach((point) => {
+        path.push(
+          `L ${this.temperatureX(point.temperature)} ${this.outputY(point.output)}`,
+        );
+      });
+      path.push(
+        `L ${this.temperatureX(this.temperatureMaximumForChart)} ${this.outputY(
+          last.output,
+        )}`,
+      );
+      return path.join(' ');
+    },
+    curveNumbersAreFinite() {
+      return this.points.every(
+        (point) =>
+          Number.isFinite(point.temperature) && Number.isFinite(point.output),
+      );
+    },
+    curveIsValid() {
+      return curveIsValid(this.points);
+    },
+    sourcesAreValid() {
+      return this.selectedSources.length > 0;
+    },
+    hysteresisIsValid() {
+      return (
+        Number.isFinite(this.positiveHysteresis) &&
+        this.positiveHysteresis >= 0 &&
+        this.positiveHysteresis <= 20 &&
+        Number.isFinite(this.negativeHysteresis) &&
+        this.negativeHysteresis >= 0 &&
+        this.negativeHysteresis <= 20
+      );
+    },
+    configurationIsValid() {
+      return (
+        this.curveIsValid && this.sourcesAreValid && this.hysteresisIsValid
+      );
+    },
+    inputState() {
+      return this.curveIsValid ? null : false;
+    },
+    hysteresisInputState() {
+      return this.hysteresisIsValid ? null : false;
+    },
+    currentTarget() {
+      return interpolateCurve(this.points, this.effectiveTemperature);
+    },
+    currentTemperatureInRange() {
+      return (
+        Number.isFinite(this.effectiveTemperature) &&
+        Number.isFinite(this.currentTarget) &&
+        this.effectiveTemperature >= this.temperatureMinimumForChart &&
+        this.effectiveTemperature <= this.temperatureMaximumForChart
+      );
+    },
+    formattedTemperature() {
+      return Number.isFinite(this.effectiveTemperature)
+        ? `${this.effectiveTemperature.toFixed(1)} °C`
+        : this.$t('pageFanControl.unavailable');
+    },
+    formattedTarget() {
+      return Number.isFinite(this.currentTarget)
+        ? `${this.currentTarget.toFixed(1)}%`
+        : this.$t('pageFanControl.unavailable');
+    },
+  },
+  created() {
+    this.loadCurve();
+  },
+  methods: {
+    setSettingsFromStore() {
+      this.points = this.readings.map((temperature, index) => ({
+        temperature,
+        output: this.outputs[index],
+      }));
+      this.selectedSources = [...this.inputs];
+      this.positiveHysteresis = this.storedPositiveHysteresis;
+      this.negativeHysteresis = this.storedNegativeHysteresis;
+    },
+    temperatureX(value) {
+      const range =
+        this.temperatureMaximumForChart - this.temperatureMinimumForChart;
+      return (
+        this.chart.left +
+        ((value - this.temperatureMinimumForChart) / range) * this.plotWidth
+      );
+    },
+    outputY(value) {
+      return this.chart.top + ((100 - value) / 100) * this.plotHeight;
+    },
+    chartValuesFromEvent(event) {
+      const bounds = this.$refs.curveChart.getBoundingClientRect();
+      const chartX =
+        ((event.clientX - bounds.left) / bounds.width) * this.chart.width;
+      const chartY =
+        ((event.clientY - bounds.top) / bounds.height) * this.chart.height;
+      return {
+        temperature:
+          this.temperatureMinimumForChart +
+          ((chartX - this.chart.left) / this.plotWidth) *
+            (this.temperatureMaximumForChart - this.temperatureMinimumForChart),
+        output: 100 - ((chartY - this.chart.top) / this.plotHeight) * 100,
+      };
+    },
+    startDrag(event, index) {
+      if (!this.curveIsValid) return;
+      event.preventDefault();
+      this.dragDomain = {
+        minimum: this.temperatureMinimumForChart,
+        maximum: this.temperatureMaximumForChart,
+      };
+      this.draggingIndex = index;
+      this.$refs.curveChart.setPointerCapture?.(event.pointerId);
+      this.dragPoint(event);
+    },
+    dragPoint(event) {
+      if (this.draggingIndex === null) return;
+      event.preventDefault();
+      const values = this.chartValuesFromEvent(event);
+      this.points[this.draggingIndex] = constrainCurvePoint(
+        this.points,
+        this.draggingIndex,
+        values.temperature,
+        values.output,
+      );
+    },
+    endDrag(event) {
+      if (this.draggingIndex === null) return;
+      if (this.$refs.curveChart.hasPointerCapture?.(event.pointerId)) {
+        this.$refs.curveChart.releasePointerCapture(event.pointerId);
+      }
+      this.draggingIndex = null;
+      this.dragDomain = null;
+    },
+    nudgePoint(event, index) {
+      const multiplier = event.shiftKey ? 5 : 1;
+      let temperature = this.points[index].temperature;
+      let output = this.points[index].output;
+      if (event.key === 'ArrowLeft') temperature -= 0.5 * multiplier;
+      else if (event.key === 'ArrowRight') temperature += 0.5 * multiplier;
+      else if (event.key === 'ArrowUp') output += multiplier;
+      else if (event.key === 'ArrowDown') output -= multiplier;
+      else return;
+
+      event.preventDefault();
+      this.points[index] = constrainCurvePoint(
+        this.points,
+        index,
+        temperature,
+        output,
+      );
+    },
+    addPoint() {
+      this.points = insertPointInWidestGap(this.points);
+    },
+    addPointAtEvent(event) {
+      if (!this.curveIsValid || this.points.length >= MAXIMUM_POINTS) return;
+      const values = this.chartValuesFromEvent(event);
+      this.points = insertCurvePoint(
+        this.points,
+        values.temperature,
+        values.output,
+      );
+    },
+    removePoint(index) {
+      if (this.points.length <= MINIMUM_POINTS) return;
+      const points = this.points.filter(
+        (point, pointIndex) => pointIndex !== index,
+      );
+      points[points.length - 1].output = MAXIMUM_OUTPUT;
+      this.points = points;
+    },
+    pointAriaLabel(point, index) {
+      return `${this.$t('pageFanControl.pointColumn')} ${index + 1}: ${point.temperature} °C, ${point.output}%`;
+    },
+    formattedSourceReading(source) {
+      return Number.isFinite(source.reading)
+        ? `${source.reading.toFixed(1)} °C`
+        : this.$t('pageFanControl.unavailable');
+    },
+    async loadCurve() {
+      this.startLoader();
+      try {
+        await this.$store.dispatch('fanControl/getFanCurve');
+        this.setSettingsFromStore();
+      } catch ({ message }) {
+        this.errorToast(message);
+      } finally {
+        this.endLoader();
+      }
+    },
+    async saveCurve() {
+      if (!this.configurationIsValid) return;
+
+      this.saving = true;
+      this.startLoader();
+      try {
+        const message = await this.$store.dispatch('fanControl/saveFanCurve', {
+          readings: this.points.map((point) => point.temperature),
+          outputs: this.points.map((point) => point.output),
+          inputs: this.selectedSources,
+          positiveHysteresis: this.positiveHysteresis,
+          negativeHysteresis: this.negativeHysteresis,
+        });
+        this.successToast(message);
+      } catch ({ message }) {
+        this.errorToast(message);
+        this.setSettingsFromStore();
+      } finally {
+        this.saving = false;
+        this.endLoader();
+      }
+    },
+  },
+};
+</script>
+
+<style lang="scss" scoped>
