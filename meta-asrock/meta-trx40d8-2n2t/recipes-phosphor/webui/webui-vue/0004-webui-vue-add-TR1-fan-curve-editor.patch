diff --git a/src/store/modules/HardwareStatus/FanControlStore.js b/src/store/modules/HardwareStatus/FanControlStore.js
new file mode 100644
index 0000000..e069684
--- /dev/null
+++ b/src/store/modules/HardwareStatus/FanControlStore.js
@@ -0,0 +1,234 @@
+import api from '@/store/api';
+import i18n from '@/i18n';
+
+const managerPath = '/redfish/v1/Managers/bmc';
+const curveName = 'TR1_Fan_Curve';
+const sensorCollectionPath =
+  '/redfish/v1/Chassis/ASRock_Rack_TRX40D8_2N2T/Sensors';
+
+function canonicalSensorName(name) {
+  return name
+    .trim()
+    .replace(/^temperature_/, '')
+    .replaceAll(' ', '_');
+}
+
+function sensorNameFromUri(uri) {
+  const segment = decodeURIComponent(
+    uri.split('/').filter(Boolean).pop() || '',
+  );
+  return canonicalSensorName(segment);
+}
+
+function transformTemperatureSensor(sensor) {
+  const uri = sensor['@odata.id'] || '';
+  const id = sensorNameFromUri(uri);
+  const reading = sensor.Reading ?? sensor.ReadingCelsius;
+  return {
+    id,
+    name: sensor.Name || id,
+    uri,
+    reading: Number.isFinite(reading) ? reading : null,
+    health: sensor.Status?.Health || 'Unknown',
+  };
+}
+
+async function getTemperatureSensors() {
+  const { data: collection } = await api.get(sensorCollectionPath);
+  if (!Array.isArray(collection.Members)) {
+    throw new Error('Invalid sensor collection response');
+  }
+
+  const responses = await api.all(
+    collection.Members.map(async (member) => {
+      if (
+        Number.isFinite(member.Reading) ||
+        Number.isFinite(member.ReadingCelsius)
+      ) {
+        return member;
+      }
+      try {
+        const { data } = await api.get(member['@odata.id']);
+        return data;
+      } catch (error) {
+        return { ...member, unavailable: true };
+      }
+    }),
+  );
+
+  return responses
+    .filter((sensor) => {
+      const uri = sensor['@odata.id'] || '';
+      return (
+        sensor.ReadingType === 'Temperature' ||
+        Number.isFinite(sensor.ReadingCelsius) ||
+        uri.includes('/temperature_')
+      );
+    })
+    .map(transformTemperatureSensor)
+    .filter((sensor) => sensor.id)
+    .sort((left, right) => left.name.localeCompare(right.name));
+}
+
+function mergeConfiguredSources(sensors, inputs) {
+  const merged = sensors.map((sensor) => ({ ...sensor }));
+  inputs.forEach((input) => {
+    const id = canonicalSensorName(input);
+    if (!merged.some((sensor) => sensor.id === id)) {
+      merged.push({
+        id,
+        name: input,
+        uri: '',
+        reading: null,
+        health: 'Unknown',
+      });
+    }
+  });
+  return merged;
+}
+
+const FanControlStore = {
+  namespaced: true,
+  state: {
+    readings: [],
+    outputs: [],
+    inputs: [],
+    positiveHysteresis: null,
+    negativeHysteresis: null,
+    temperatureSensors: [],
+  },
+  getters: {
+    readings: (state) => state.readings,
+    outputs: (state) => state.outputs,
+    inputs: (state) => state.inputs,
+    positiveHysteresis: (state) => state.positiveHysteresis,
+    negativeHysteresis: (state) => state.negativeHysteresis,
+    temperatureSensors: (state) => state.temperatureSensors,
+    selectedSensors: (state) =>
+      state.inputs.map((input) =>
+        state.temperatureSensors.find((sensor) => sensor.id === input),
+      ),
+    allSourcesAvailable: (state, getters) =>
+      state.inputs.length > 0 &&
+      getters.selectedSensors.every(
+        (sensor) => sensor && Number.isFinite(sensor.reading),
+      ),
+    effectiveTemperature: (state, getters) => {
+      if (!getters.allSourcesAvailable) return null;
+      return Math.max(
+        ...getters.selectedSensors.map((sensor) => sensor.reading),
+      );
+    },
+  },
+  mutations: {
+    setCurve(state, curve) {
+      state.readings = curve.Reading;
+      state.outputs = curve.Output;
+      state.inputs = curve.Inputs.map(canonicalSensorName);
+      state.positiveHysteresis = curve.PositiveHysteresis;
+      state.negativeHysteresis = curve.NegativeHysteresis;
+    },
+    setTemperatureSensors(state, sensors) {
+      state.temperatureSensors = sensors;
+    },
+  },
+  actions: {
+    async getFanCurve({ commit }) {
+      try {
+        const [curveResponse, temperatureSensors] = await api.all([
+          api.get(managerPath),
+          getTemperatureSensors(),
+        ]);
+        const curve =
+          curveResponse.data?.Oem?.OpenBmc?.Fan?.StepwiseControllers?.[
+            curveName
+          ];
+        const steps = curve?.Steps;
+        const inputs = curve?.Inputs;
+
+        if (
+          !Array.isArray(steps) ||
+          steps.length < 2 ||
+          steps.length > 20 ||
+          !steps.every(
+            (step) =>
+              Number.isFinite(step.Target) && Number.isFinite(step.Output),
+          ) ||
+          !Array.isArray(inputs) ||
+          !inputs.length ||
+          !inputs.every((input) => typeof input === 'string') ||
+          !Number.isFinite(curve.PositiveHysteresis) ||
+          !Number.isFinite(curve.NegativeHysteresis)
+        ) {
+          throw new Error('Invalid fan curve response');
+        }
+
+        const canonicalInputs = inputs.map(canonicalSensorName);
+        commit('setCurve', {
+          Reading: steps.map((step) => step.Target),
+          Output: steps.map((step) => step.Output),
+          Inputs: canonicalInputs,
+          PositiveHysteresis: curve.PositiveHysteresis,
+          NegativeHysteresis: curve.NegativeHysteresis,
+        });
+        commit(
+          'setTemperatureSensors',
+          mergeConfiguredSources(temperatureSensors, canonicalInputs),
+        );
+      } catch (error) {
+        console.log(error);
+        throw new Error(
+          i18n.global.t('pageFanControl.toast.errorLoadSettings'),
+        );
+      }
+    },
+    async saveFanCurve(
+      { commit, dispatch, state },
+      { readings, outputs, inputs, positiveHysteresis, negativeHysteresis },
+    ) {
+      try {
+        const canonicalInputs = inputs.map(canonicalSensorName);
+        const steps = readings.map((target, index) => ({
+          Target: target,
+          Output: outputs[index],
+        }));
+        await api.patch(managerPath, {
+          Oem: {
+            OpenBmc: {
+              Fan: {
+                StepwiseControllers: {
+                  [curveName]: {
+                    Inputs: canonicalInputs,
+                    NegativeHysteresis: negativeHysteresis,
+                    PositiveHysteresis: positiveHysteresis,
+                    Steps: steps,
+                  },
+                },
+              },
+            },
+          },
+        });
+        commit('setCurve', {
+          Reading: readings,
+          Output: outputs,
+          Inputs: canonicalInputs,
+          PositiveHysteresis: positiveHysteresis,
+          NegativeHysteresis: negativeHysteresis,
+        });
+        commit(
+          'setTemperatureSensors',
+          mergeConfiguredSources(state.temperatureSensors, canonicalInputs),
+        );
+        return i18n.global.t('pageFanControl.toast.successSaveSettings');
+      } catch (error) {
+        console.log(error);
+        await dispatch('getFanCurve').catch(() => {});
+        throw new Error(
+          i18n.global.t('pageFanControl.toast.errorSaveSettings'),
+        );
+      }
+    },
+  },
+};
+
+export default FanControlStore;
