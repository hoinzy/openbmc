+          <b-card-text>
+            {{ $t('pageFanControl.curveDescription') }}
+          </b-card-text>
+
+          <dl class="curve-status">
+            <div>
+              <dt>{{ $t('pageFanControl.currentTemperature') }}</dt>
+              <dd>{{ formattedTemperature }}</dd>
+            </div>
+            <div>
+              <dt>{{ $t('pageFanControl.currentTarget') }}</dt>
