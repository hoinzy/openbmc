From 427b0ac413864f45d2f9c99220ec1b3e72344076 Mon Sep 17 00:00:00 2001
From: Till Heinzerling <1684934+hoinzy@users.noreply.github.com>
Date: Thu, 30 Jul 2026 23:40:00 +0200
Subject: [PATCH] webui-vue: keep direct virtual-media slot

Some platforms use bmcweb's direct /vm/0/0 NBD proxy for browser-selected
files while exposing only server-side legacy slots over the Redfish
VirtualMedia collection. Keep the default direct slot when the collection
contains no OEM proxy device so both modes remain usable.

Upstream-Status: Pending
Signed-off-by: Till Heinzerling <1684934+hoinzy@users.noreply.github.com>
---
 src/store/modules/Operations/VirtualMediaStore.js | 23 ++++++++++++++---------
 1 file changed, 14 insertions(+), 9 deletions(-)

diff --git a/src/store/modules/Operations/VirtualMediaStore.js b/src/store/modules/Operations/VirtualMediaStore.js
index c8fa5f8..e859fd9 100644
--- a/src/store/modules/Operations/VirtualMediaStore.js
+++ b/src/store/modules/Operations/VirtualMediaStore.js
@@ -12,6 +12,15 @@ const transferProtocolType = {
   OEM: 'OEM',
 };
 
+const getDefaultProxyDevice = () => ({
+  id: i18n.global.t('pageVirtualMedia.defaultDeviceName'),
+  websocket: '/vm/0/0',
+  file: null,
+  nbd: null,
+  transferProtocolType: transferProtocolType.OEM,
+  isActive: false,
+});
+
 const VirtualMediaStore = {
   namespaced: true,
   state: {
@@ -67,15 +76,7 @@ const VirtualMediaStore = {
           ? true
           : false;
       if (!virtualMediaListEnabled) {
-        const device = {
-          id: i18n.global.t('pageVirtualMedia.defaultDeviceName'),
-          websocket: '/vm/0/0',
-          file: null,
-          nbd: null,
-          transferProtocolType: transferProtocolType.OEM,
-          isActive: false,
-        };
-        commit('setProxyDevicesData', [device]);
+        commit('setProxyDevicesData', [getDefaultProxyDevice()]);
         return;
       }
 
@@ -111,6 +112,10 @@ const VirtualMediaStore = {
                 nbd: null,
               };
             });
+          if (proxyDevices.length === 0) {
+            proxyDevices.push(getDefaultProxyDevice());
+          }
+
           const legacyDevices = deviceData
             .filter((d) => d.transferProtocolType !== transferProtocolType.OEM)
             .map((device) => {
-- 
