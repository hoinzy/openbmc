+    encodeShareUri(value) {
+      const shareUri = value.trim();
+      const schemeEnd = shareUri.indexOf('://');
+      if (schemeEnd < 0) return shareUri;
+      const pathStart = shareUri.indexOf('/', schemeEnd + 3);
+      if (pathStart < 0) return shareUri;
+
+      const encodeSegment = (segment) => {
+        try {
+          return encodeURIComponent(decodeURIComponent(segment));
+        } catch {
+          return encodeURIComponent(segment);
+        }
+      };
+      const authority = shareUri.substring(0, pathStart);
+      const path = shareUri
+        .substring(pathStart)
+        .split('/')
+        .map(encodeSegment)
+        .join('/');
+      return authority + path;
+    },
+    listImages() {
+      this.imageListError = false;
+      this.imageListEmpty = false;
+      this.isListingImages = true;
+      const isNfs = this.form.shareUri
+        .trim()
+        .toLowerCase()
+        .startsWith('nfs://');
+      this.$store
+        .dispatch('virtualMedia/listImages', {
+          id: this.connection.id,
+          data: {
+            Share: this.encodeShareUri(this.form.shareUri),
+            UserName: isNfs ? '' : this.form.username || '',
+            Password: isNfs ? '' : this.form.password || '',
+          },
+        })
+        .then((images) => {
+          this.images = images;
+          this.imageListEmpty = images.length === 0;
+          this.form.selectedImage = null;
+        })
+        .catch(() => {
+          this.images = [];
+          this.imageListError = true;
+        })
+        .finally(() => {
+          this.isListingImages = false;
+        });
+    },
+    onShareChanged() {
+      this.images = [];
+      this.form.selectedImage = null;
+      this.imageListEmpty = false;
+      this.imageListError = false;
+    },
     closeModal() {
       this.$nextTick(() => {
         this.$refs.modal.hide();
@@ -153,7 +281,13 @@ export default {
