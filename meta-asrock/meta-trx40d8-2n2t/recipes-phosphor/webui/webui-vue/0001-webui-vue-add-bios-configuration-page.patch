         "eventLogs": "@:appPageTitle.eventLogs",
         "factoryReset": "@:appPageTitle.factoryReset",
+        "biosConfiguration": "@:appPageTitle.biosConfiguration",
         "firmware": "@:appPageTitle.firmware",
         "hardwareStatus": "Hardware status",
         "inventory": "@:appPageTitle.inventory",
@@ -156,6 +157,7 @@
         "dumps": "Dumps",
         "eventLogs": "Event logs",
         "factoryReset": "Factory reset",
+        "biosConfiguration": "BIOS configuration",
         "firmware": "Firmware",
         "inventory": "Inventory and LEDs",
         "kvm": "KVM",
@@ -178,6 +180,10 @@
         "virtualMedia": "Virtual media",
         "keyClear": "Key clear"
     },
+    "pageBiosConfiguration": {
+        "description": "Review or stage firmware settings. Saved changes are applied by the host firmware on the next server boot.",
+        "frameTitle": "Host BIOS configuration"
+    },
     "pageChangePassword": {
         "changePassword": "Change password",
         "changePasswordAlertMessage": "The password is expired and must be changed.",
