From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenBMC Builder <openbmc-builder@users.noreply.github.com>
Date: Thu, 30 Jul 2026 22:45:00 +0200
Subject: [PATCH] webui-vue: add BIOS configuration page

Expose the firmware-provided BIOS setup application inside the authenticated
OpenBMC WebUI.  Keep the entry administrator-only because it can stage host
firmware changes.

Upstream-Status: Pending [generic BIOS settings user experience]
---
 src/components/AppNavigation/AppNavigationMixin.js |  6 ++++
 src/locales/en-US.json                             |  6 ++++
 src/router/routes.js                               | 10 +++++++
 .../BiosConfiguration/BiosConfiguration.vue        | 33 ++++++++++++++++++++++
 src/views/Operations/BiosConfiguration/index.js    |  2 ++
 5 files changed, 57 insertions(+)

diff --git a/src/components/AppNavigation/AppNavigationMixin.js b/src/components/AppNavigation/AppNavigationMixin.js
index dc9e050..99db3e8 100644
--- a/src/components/AppNavigation/AppNavigationMixin.js
+++ b/src/components/AppNavigation/AppNavigationMixin.js
@@ -88,6 +88,12 @@ const AppNavigationMixin = {
               label: i18n.global.t('appNavigation.kvm'),
               route: '/operations/kvm',
             },
+            {
+              id: 'bios-configuration',
+              label: i18n.global.t('appNavigation.biosConfiguration'),
+              route: '/operations/bios-configuration',
+              exclusiveToRoles: [roles.administrator],
+            },
             {
               id: 'key-clear',
               label: i18n.global.t('appNavigation.keyClear'),
diff --git a/src/locales/en-US.json b/src/locales/en-US.json
index b4e1df0..7ea056f 100644
