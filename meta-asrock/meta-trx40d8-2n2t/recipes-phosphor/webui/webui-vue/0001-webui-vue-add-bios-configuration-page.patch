index f3f6f6b..eb77f4c 100644
--- a/src/router/routes.js
+++ b/src/router/routes.js
@@ -1,4 +1,5 @@
 import AppLayout from '@/layouts/AppLayout.vue';
+import BiosConfiguration from '@/views/Operations/BiosConfiguration';
 import ChangePassword from '@/views/ChangePassword';
 import ConsoleLayout from '@/layouts/ConsoleLayout.vue';
 import DateTime from '@/views/Settings/DateTime';
@@ -233,6 +234,15 @@ const routes = [
           title: i18n.global.t('appPageTitle.kvm'),
         },
       },
+      {
+        path: '/operations/bios-configuration',
+        name: 'bios-configuration',
+        component: BiosConfiguration,
+        meta: {
+          title: i18n.global.t('appPageTitle.biosConfiguration'),
+          exclusiveToRoles: [roles.administrator],
+        },
+      },
       {
         path: '/operations/firmware',
         name: 'firmware',
diff --git a/src/views/Operations/BiosConfiguration/BiosConfiguration.vue b/src/views/Operations/BiosConfiguration/BiosConfiguration.vue
new file mode 100644
index 0000000..dc83a30
--- /dev/null
+++ b/src/views/Operations/BiosConfiguration/BiosConfiguration.vue
@@ -0,0 +1,33 @@
+<template>
+  <b-container fluid>
+    <page-title
+      class="mb-4"
+      :description="$t('pageBiosConfiguration.description')"
+    />
+    <iframe
+      class="bios-configuration-frame"
+      src="/bios/"
+      :title="$t('pageBiosConfiguration.frameTitle')"
+    ></iframe>
+  </b-container>
+</template>
+
+<script>
+import PageTitle from '@/components/Global/PageTitle';
+
+export default {
+  name: 'BiosConfiguration',
+  components: {
+    PageTitle,
+  },
+};
+</script>
+
+<style scoped>
+.bios-configuration-frame {
+  width: 100%;
+  min-height: calc(100vh - 13rem);
+  border: 1px solid #d8d8d8;
+  background: #fff;
+}
+</style>
