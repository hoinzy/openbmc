[Unit]
Description=AMI host firmware inventory
Wants=xyz.openbmc_project.biosconfig_manager.service
After=xyz.openbmc_project.biosconfig_manager.service
After=dbus.service

[Service]
ExecStart=/usr/bin/ami-host-inventory
Restart=on-failure
StateDirectory=ami-host-inventory
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
