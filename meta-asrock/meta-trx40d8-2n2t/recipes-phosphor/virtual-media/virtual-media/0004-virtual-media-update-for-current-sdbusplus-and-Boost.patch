diff --git a/src/system.hpp b/src/system.hpp
index f23e3d8..9839c36 100644
--- a/src/system.hpp
+++ b/src/system.hpp
@@ -4,6 +4,7 @@
 
 #include <algorithm>
 #include <boost/asio.hpp>
+#include <boost/asio/detached.hpp>
 #include <boost/asio/spawn.hpp>
 #include <boost/container/flat_map.hpp>
 #include <boost/process/v1.hpp>
@@ -316,7 +317,7 @@ class DeviceMonitor
                     }
                 }
             }
-        });
+        }, boost::asio::detached);
     }
 
     void addDevice(const NBDDevice& device)
@@ -416,7 +417,7 @@ class Process : public std::enable_shared_from_this<Process>
             while (child.running() && waitCnt > 0)
             {
                 boost::system::error_code ignored_ec;
-                timer.expires_from_now(std::chrono::milliseconds(100));
+                timer.expires_after(std::chrono::milliseconds(100));
                 timer.async_wait(yield[ignored_ec]);
                 waitCnt--;
             }
@@ -431,7 +432,7 @@ class Process : public std::enable_shared_from_this<Process>
                    " Native: ", child.native_exit_code());
 
             onExit(child.exit_code());
-        });
+        }, boost::asio::detached);
         return true;
     }
 
@@ -450,7 +451,7 @@ class Process : public std::enable_shared_from_this<Process>
             while (child.running() && waitCnt > 0)
             {
                 boost::system::error_code ignored_ec;
-                timer.expires_from_now(std::chrono::milliseconds(100));
+                timer.expires_after(std::chrono::milliseconds(100));
                 timer.async_wait(yield[ignored_ec]);
                 waitCnt--;
             }
@@ -461,7 +462,7 @@ class Process : public std::enable_shared_from_this<Process>
                 child.terminate();
                 onTerminate();
             }
-        });
+        }, boost::asio::detached);
     }
 
     std::string application()
diff --git a/src/utils.hpp b/src/utils.hpp
index 46f0f61..0722475 100644
--- a/src/utils.hpp
+++ b/src/utils.hpp
@@ -389,7 +389,7 @@ class NotificationWrapper
     {
         LogMsg(Logger::Debug, "Notification initiated");
