 namespace fs = std::filesystem;
 
@@ -497,22 +501,102 @@ class FsHelper
 struct UsbGadget : private FsHelper
 {
   private:
+    static constexpr const char* gadgetRoot =
+        "/sys/kernel/config/usb_gadget";
+    static constexpr const char* vhubRoot =
+        "/sys/bus/platform/devices/1e6a0000.usb-vhub";
+
     static const std::string getGadgetDirPrefix()
     {
         const std::string gadgetDirPrefix =
-            "/sys/kernel/config/usb_gadget/mass-storage-";
+            std::string(gadgetRoot) + "/mass-storage-";
         return gadgetDirPrefix;
     }
 
+    static std::vector<std::string> getUdcCandidates()
+    {
+        std::vector<std::string> candidates;
+        std::error_code ec;
+        for (const auto& port : fs::directory_iterator(vhubRoot, ec))
+        {
+            if (ec)
+            {
+                break;
+            }
+            if (port.is_directory(ec) && !port.is_symlink(ec))
+            {
+                candidates.emplace_back(port.path().filename());
+            }
+        }
+        std::sort(candidates.begin(), candidates.end());
+        return candidates;
+    }
+
+    static std::set<std::string> getOccupiedUdcs()
+    {
+        std::set<std::string> occupied;
+        std::error_code ec;
+        for (const auto& gadget : fs::directory_iterator(gadgetRoot, ec))
+        {
+            if (ec)
+            {
+                break;
+            }
+            std::ifstream udcFile(gadget.path() / "UDC");
+            std::string udc;
+            if (std::getline(udcFile, udc) && !udc.empty())
+            {
+                occupied.insert(std::move(udc));
+            }
+        }
+        return occupied;
+    }
+
   public:
+    static std::optional<std::string>
+        selectUdc(const std::optional<std::string>& requested,
+                  const std::vector<std::string>& candidates,
+                  const std::set<std::string>& occupied,
+                  const std::set<std::string>& reserved)
+    {
+        const auto usable = [&](const std::string& udc) {
+            return std::find(candidates.begin(), candidates.end(), udc) !=
+                       candidates.end() &&
+                   !occupied.contains(udc) && !reserved.contains(udc);
+        };
+
+        if (requested)
+        {
+            if (usable(*requested))
+            {
+                return requested;
+            }
+            return std::nullopt;
+        }
+
+        auto sorted = candidates;
+        std::sort(sorted.begin(), sorted.end());
+        const auto selected = std::find_if(sorted.begin(), sorted.end(), usable);
+        if (selected == sorted.end())
+        {
+            return std::nullopt;
+        }
+        return *selected;
+    }
+
     static int32_t configure(const std::string& name, const NBDDevice& nbd,
-                             StateChange change, const bool rw = false)
+                             StateChange change, const bool rw = false,
+                             std::optional<std::string> udc = std::nullopt,
+                             std::set<std::string> reservedUdcs = {})
     {
-        return configure(name, nbd.to_path(), change, rw);
+        return configure(name, nbd.to_path(), change, rw, std::move(udc),
+                         std::move(reservedUdcs));
     }
 
     static int32_t configure(const std::string& name, const fs::path& path,
-                             StateChange change, const bool rw = false)
+                             StateChange change, const bool rw = false,
+                             std::optional<std::string> udc = std::nullopt,
+                             std::set<std::string> reservedUdcs = {})
     {
         LogMsg(Logger::Info, "[App]: Configure USB Gadget (name=", name,
                ", path=", path, ", State=", static_cast<uint32_t>(change), ")");
@@ -535,6 +619,15 @@ struct UsbGadget : private FsHelper
 
