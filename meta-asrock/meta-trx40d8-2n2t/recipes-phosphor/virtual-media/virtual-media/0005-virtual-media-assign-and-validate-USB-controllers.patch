diff --git a/tests/src/main.cpp b/tests/src/main.cpp
index 9bb465e..e075fec 100644
--- a/tests/src/main.cpp
+++ b/tests/src/main.cpp
@@ -1,5 +1,65 @@
+#include "system.hpp"
+
 #include <gtest/gtest.h>
 
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+TEST(UsbGadgetUdcSelection, ReservedAndBusyPortsAreExcluded)
+{
+    const std::vector<std::string> candidates = {
+        "1e6a0000.usb-vhub:p1", "1e6a0000.usb-vhub:p2",
+        "1e6a0000.usb-vhub:p3"};
+    const std::set<std::string> occupied = {"1e6a0000.usb-vhub:p2"};
+    const std::set<std::string> reserved = {"1e6a0000.usb-vhub:p1"};
+
+    EXPECT_EQ(UsbGadget::selectUdc(std::nullopt, candidates, occupied,
+                                  reserved),
+              std::optional<std::string>{"1e6a0000.usb-vhub:p3"});
+    EXPECT_FALSE(UsbGadget::selectUdc(
+        std::optional<std::string>{"1e6a0000.usb-vhub:p1"}, candidates,
+        occupied, reserved));
+    EXPECT_FALSE(UsbGadget::selectUdc(
+        std::optional<std::string>{"1e6a0000.usb-vhub:p2"}, candidates,
+        occupied, reserved));
+}
+
+TEST(UsbGadgetUdcSelection, TwoSlotsAreUniqueAndReleasedPortIsReusable)
+{
+    const std::vector<std::string> candidates = {
+        "1e6a0000.usb-vhub:p1", "1e6a0000.usb-vhub:p2",
+        "1e6a0000.usb-vhub:p3", "1e6a0000.usb-vhub:p4",
+        "1e6a0000.usb-vhub:p5"};
+    const std::set<std::string> reserved = {
+        "1e6a0000.usb-vhub:p1", "1e6a0000.usb-vhub:p2"};
+    std::set<std::string> occupied;
+
+    const auto slot1 = UsbGadget::selectUdc(
+        std::optional<std::string>{"1e6a0000.usb-vhub:p3"}, candidates,
+        occupied, reserved);
+    ASSERT_TRUE(slot1);
+    occupied.insert(*slot1);
+
+    const auto slot2 = UsbGadget::selectUdc(
+        std::optional<std::string>{"1e6a0000.usb-vhub:p4"}, candidates,
+        occupied, reserved);
+    ASSERT_TRUE(slot2);
+    EXPECT_NE(slot1, slot2);
+    occupied.insert(*slot2);
+
+    EXPECT_FALSE(UsbGadget::selectUdc(
+        std::optional<std::string>{"1e6a0000.usb-vhub:p3"}, candidates,
+        occupied, reserved));
+
+    occupied.erase(*slot1);
+    EXPECT_EQ(UsbGadget::selectUdc(
+                  std::optional<std::string>{"1e6a0000.usb-vhub:p3"},
+                  candidates, occupied, reserved),
+              slot1);
+}
