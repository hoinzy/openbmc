+    static std::vector<std::string> listImages(
+        interfaces::MountPointStateMachine& machine,
+        const std::string& shareUrl,
+        const std::unique_ptr<utils::CredentialsProvider>& credentials)
+    {
+        auto mountDir = std::make_unique<resource::Directory>(
+            std::string(machine.getName()) + "-browse");
+        const fs::path localPath = mountDir->getPath();
+        std::unique_ptr<resource::Mount> mountedShare;
+
+        if (shareUrl.starts_with("smb://"))
+        {
+            std::string remote;
+            if (!utils::percentDecode(
+                    shareUrl.substr(std::string("smb://").size() - 1),
+                    &remote))
+            {
+                throw resource::Error(std::errc::invalid_argument,
+                                      "Invalid SMB share URL");
+            }
+            SmbShare smb(localPath);
+            mountedShare = std::make_unique<resource::Mount>(
+                std::move(mountDir), smb, remote, false, credentials);
+        }
+        else if (shareUrl.starts_with("nfs://"))
+        {
+            const std::string remoteUrl =
+                shareUrl.substr(std::string("nfs://").size());
+            const auto pathStart = remoteUrl.find('/');
+            if (pathStart == std::string::npos || pathStart == 0)
+            {
+                throw resource::Error(std::errc::invalid_argument,
+                                      "Invalid NFS share URL");
+            }
+
+            std::string decodedPath;
+            if (!utils::percentDecode(remoteUrl.substr(pathStart),
+                                      &decodedPath))
+            {
+                throw resource::Error(std::errc::invalid_argument,
+                                      "Invalid NFS share URL");
+            }
+            const fs::path remote =
+                remoteUrl.substr(0, pathStart) + ":" + decodedPath;
+            NfsShare nfs(localPath);
+            mountedShare = std::make_unique<resource::Mount>(
+                std::move(mountDir), nfs, remote, false, credentials);
+        }
+        else
+        {
+            throw resource::Error(std::errc::protocol_not_supported,
+                                  "Unsupported share protocol");
+        }
+
+        static const std::set<std::string> extensions = {
+            ".ima", ".img", ".iso", ".nrg"};
+        std::vector<std::string> images;
+        std::error_code ec;
+        fs::directory_iterator iterator(localPath, ec);
+        if (ec)
+        {
+            throw resource::Error(std::errc::io_error,
+                                  "Unable to list remote share");
+        }
+
+        for (const auto& entry : iterator)
+        {
+            const bool isSymlink = entry.is_symlink(ec);
+            if (ec)
+            {
+                throw resource::Error(std::errc::io_error,
+                                      "Unable to inspect remote image");
+            }
+            const bool isRegular = entry.is_regular_file(ec);
+            if (ec)
+            {
+                throw resource::Error(std::errc::io_error,
+                                      "Unable to inspect remote image");
+            }
+            if (isSymlink || !isRegular)
+            {
+                continue;
+            }
+
+            std::string extension = entry.path().extension();
+            std::transform(extension.begin(), extension.end(),
+                           extension.begin(), [](unsigned char character) {
+                               return static_cast<char>(
+                                   std::tolower(character));
+                           });
+            if (!extensions.contains(extension))
+            {
+                continue;
+            }
+
+            images.emplace_back(entry.path().filename().string());
+            if (images.size() == 256)
+            {
+                break;
+            }
+        }
+
+        std::sort(images.begin(), images.end());
+        return images;
+    }
+
     void addServiceInterface(const RegisterDbusEvent& event,
