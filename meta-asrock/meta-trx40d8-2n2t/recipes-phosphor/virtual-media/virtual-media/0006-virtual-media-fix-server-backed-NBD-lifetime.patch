+TEST(NbdClientArguments, LegacyCanDaemonizeWithoutChangingProxyMode)
+{
+    Configuration::MountPoint mp{};
+    mp.nbdDevice = NBDDevice(NBDDevice::nbd2);
+    mp.unixSocket = "/run/virtual-media/nbd2.sock";
+    mp.timeout = 90;
+
+    const std::vector<std::string> foreground = {
+        "-t", "90", "-u", "/run/virtual-media/nbd2.sock", "/dev/nbd2",
+        "-n"};
+    const std::vector<std::string> daemon = {
+        "-t", "90", "-u", "/run/virtual-media/nbd2.sock", "/dev/nbd2"};
+
+    EXPECT_EQ(Configuration::MountPoint::toArgs(mp), foreground);
+    EXPECT_EQ(Configuration::MountPoint::toArgs(mp, false), daemon);
+}
