From 5ff4fcf4fc1216c7f5269c431634a0cb27c1b211 Mon Sep 17 00:00:00 2001
From: Till Heinzerling <till.heinzerling1@vodafone.com>
Date: Tue, 11 Aug 2026 11:00:54 +0200
Subject: [PATCH] phosphor-pid-control: interpolate stepwise control points

Keep the existing Stepwise configuration and hysteresis contracts, but calculate a piecewise-linear output between adjacent points. Clamp below and above the configured range and cover interpolation in the controller tests.
---
 pid/ec/stepwise.cpp                      | 36 +++++++++++++++++++-----
 test/pid_stepwisecontroller_unittest.cpp | 31 ++++++++++++++++----
 2 files changed, 54 insertions(+), 13 deletions(-)

diff --git a/pid/ec/stepwise.cpp b/pid/ec/stepwise.cpp
index b768416..d9994ec 100644
--- a/pid/ec/stepwise.cpp
+++ b/pid/ec/stepwise.cpp
@@ -26,23 +26,45 @@ namespace ec
 
 double stepwise(const ec::StepwiseInfo& info, double input)
 {
-    double value = info.output[0]; // if we are below the lowest
-                                   // point, we set the lowest value
+    double previousReading = info.reading[0];
+    double previousOutput = info.output[0];
+
+    // Clamp readings below the configured range to the first output.
+    if (input <= previousReading)
+    {
+        return previousOutput;
+    }
 
     for (size_t ii = 1; ii < ec::maxStepwisePoints; ii++)
     {
-        if (std::isnan(info.reading[ii]))
+        const double reading = info.reading[ii];
+        if (std::isnan(reading))
         {
             break;
         }
-        if (info.reading[ii] > input)
+
+        const double output = info.output[ii];
+        if (input <= reading)
         {
-            break;
+            // Configuration validation requires strictly increasing readings.
+            // Retain a safe result if malformed data reaches this layer rather
+            // than dividing by zero.
+            if (reading <= previousReading)
+            {
+                return output;
+            }
+
+            const double fraction =
+                (input - previousReading) / (reading - previousReading);
+            return previousOutput + fraction * (output - previousOutput);
         }
-        value = info.output[ii];
+
+        previousReading = reading;
+        previousOutput = output;
     }
 
-    return value;
+    // Clamp readings above the configured range to the final output.
+    return previousOutput;
 }
 
 } // namespace ec
diff --git a/test/pid_stepwisecontroller_unittest.cpp b/test/pid_stepwisecontroller_unittest.cpp
index c730606..bc42744 100644
--- a/test/pid_stepwisecontroller_unittest.cpp
+++ b/test/pid_stepwisecontroller_unittest.cpp
@@ -19,6 +19,25 @@ namespace
 using ::testing::Return;
 using ::testing::StrEq;
 
+TEST(StepwiseControllerTest, InterpolatesBetweenConfiguredPoints)
+{
+    ec::StepwiseInfo info{};
+    info.reading[0] = 20.0;
+    info.reading[1] = 30.0;
+    info.reading[2] = 50.0;
+    info.reading[3] = std::numeric_limits<double>::quiet_NaN();
+    info.output[0] = 40.0;
+    info.output[1] = 60.0;
+    info.output[2] = 100.0;
+
+    EXPECT_DOUBLE_EQ(ec::stepwise(info, 15.0), 40.0);
+    EXPECT_DOUBLE_EQ(ec::stepwise(info, 20.0), 40.0);
+    EXPECT_DOUBLE_EQ(ec::stepwise(info, 25.0), 50.0);
+    EXPECT_DOUBLE_EQ(ec::stepwise(info, 30.0), 60.0);
+    EXPECT_DOUBLE_EQ(ec::stepwise(info, 40.0), 80.0);
+    EXPECT_DOUBLE_EQ(ec::stepwise(info, 55.0), 100.0);
+}
+
 TEST(StepwiseControllerTest, HysteresisTestPositive)
 {
     // Verifies positive hysteresis works as expected
@@ -42,11 +61,11 @@ TEST(StepwiseControllerTest, HysteresisTestPositive)
 
     EXPECT_CALL(z, getCachedValue(StrEq("test")))
         .Times(3)
-        .WillOnce(Return(29.0))  // return 40
-        .WillOnce(Return(31.0))  // return 40
+        .WillOnce(Return(29.0))  // return 58
+        .WillOnce(Return(31.0))  // remain at 58
         .WillOnce(Return(32.0)); // return 60
 
-    EXPECT_CALL(z, addSetPoint(40.0, "foo")).Times(2);
+    EXPECT_CALL(z, addSetPoint(58.0, "foo")).Times(2);
     EXPECT_CALL(z, addSetPoint(60.0, "foo")).Times(1);
 
     for (int ii = 0; ii < 3; ii++)
@@ -79,10 +98,10 @@ TEST(StepwiseControllerTest, HysteresisTestNegative)
     EXPECT_CALL(z, getCachedValue(StrEq("test")))
         .Times(3)
         .WillOnce(Return(30.0))  // return 60
-        .WillOnce(Return(27.0))  // return 60
-        .WillOnce(Return(26.0)); // return 40
+        .WillOnce(Return(27.0))  // remain at 60
+        .WillOnce(Return(26.0)); // return 52
 
-    EXPECT_CALL(z, addSetPoint(40.0, "foo")).Times(1);
+    EXPECT_CALL(z, addSetPoint(52.0, "foo")).Times(1);
     EXPECT_CALL(z, addSetPoint(60.0, "foo")).Times(2);
 
     for (int ii = 0; ii < 3; ii++)
-- 
